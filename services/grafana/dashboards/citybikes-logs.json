{
  "uid": "citybikes-logs",
  "title": "CityBikes logs",
  "tags": [
    "citybikes",
    "logs"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "VM",
        "type": "custom",
        "query": "db,fetcher,history,ui,bastion",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "db",
            "value": "db",
            "selected": false
          },
          {
            "text": "fetcher",
            "value": "fetcher",
            "selected": false
          },
          {
            "text": "history",
            "value": "history",
            "selected": false
          },
          {
            "text": "ui",
            "value": "ui",
            "selected": false
          },
          {
            "text": "bastion",
            "value": "bastion",
            "selected": false
          }
        ]
      },
      {
        "name": "container",
        "label": "Container",
        "type": "custom",
        "query": "postgres,redis,rabbitmq,loki,grafana,fetcher,history,ui,log-agent",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "postgres",
            "value": "postgres",
            "selected": false
          },
          {
            "text": "redis",
            "value": "redis",
            "selected": false
          },
          {
            "text": "rabbitmq",
            "value": "rabbitmq",
            "selected": false
          },
          {
            "text": "loki",
            "value": "loki",
            "selected": false
          },
          {
            "text": "grafana",
            "value": "grafana",
            "selected": false
          },
          {
            "text": "fetcher",
            "value": "fetcher",
            "selected": false
          },
          {
            "text": "history",
            "value": "history",
            "selected": false
          },
          {
            "text": "ui",
            "value": "ui",
            "selected": false
          },
          {
            "text": "log-agent",
            "value": "log-agent",
            "selected": false
          }
        ]
      },
      {
        "name": "search",
        "label": "Search text",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "text": "",
            "value": "",
            "selected": true
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Containers sending logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (host, container) (count_over_time({source=\"docker\"}[$__range])))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log lines per container",
      "description": "How much each container writes. A flat zero for a service means it is down or silent.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container) (count_over_time({source=\"docker\", host=~\"$host\"}[$__interval]))",
          "queryType": "range",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors per container",
      "description": "Lines containing error / exception / traceback / critical / fatal.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container) (count_over_time({source=\"docker\", host=~\"$host\"} |~ \"(?i)(error|exception|traceback|critical|fatal)\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SSH events per VM (journal)",
      "description": "Successful and failed SSH logins on every VM. The bastion shows the logins from outside.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (host) (count_over_time({source=\"journal\", host=~\"$host\", unit=~\"ssh(d)?.service\"} |~ \"Accepted|Failed|Invalid user\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Container logs",
      "description": "Everything the containers print. Use the variables above to narrow it down.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"docker\", host=~\"$host\", container=~\"$container\"} |~ \"(?i)$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Errors and warnings",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"docker\", host=~\"$host\", container=~\"$container\"} |~ \"(?i)(error|exception|traceback|critical|fatal)|(?i)warning\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "SSH logins and failures",
      "description": "Who logged in to which VM (the bastion logs the first hop, the other VMs the second).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"journal\", host=~\"$host\", unit=~\"ssh(d)?.service\"} |~ \"Accepted|Failed|Invalid user|Disconnected|session opened\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
