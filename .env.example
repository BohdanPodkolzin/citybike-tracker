6# Copy to .env (never commit .env).
# Write comments on their OWN lines: the Vagrantfile reads everything after "=" as the value.

# Required. Passwords must not contain quote characters.
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me 
# Grafana login: user admin, this password (used when Grafana is first created)
GRAFANA_PASSWORD=change-me # graffpassezgoing

# Runtime switches (no rebuild needed: bash scripts/switch-backend.sh queue=postgres cache=postgres)
# Queue between History and Fetcher: rabbitmq or postgres
QUEUE_BACKEND=rabbitmq
# Where user preferences are stored: redis or postgres
CACHE_BACKEND=redis

# Optional (defaults shown)
# Your home network: only ui (.53) and bastion (.54) join it
# LAN_PREFIX=192.168.0
# Private network of all VMs: .50 db, .51 fetcher, .52 history, .53 ui, .54 bastion
# PRIVATE_PREFIX=10.20.0
# Key pair for the bastion (bash scripts/setup-ssh.sh creates it)
# SSH_KEY_FILE=~/.ssh/citybikes_ed25519
# SSH_INTERNAL_KEY_FILE=~/.ssh/citybikes_internal_ed25519
# Name of your computer's network card, if Vagrant asks which one to bridge
# BRIDGE_INTERFACE=
# DB_NAME=citybikes
# DB_USER=citybikes_app
# DB_PORT=5432
# RABBITMQ_USER=citybikes
# RABBITMQ_VHOST=citybikes
# RABBITMQ_PORT=5672
# LOKI_PORT=3100
# GRAFANA_PORT=3000
# REDIS_PORT=6379
# HISTORY_PORT=8002
# ALLOWED_CIDR=10.20.0.0/24
# POLL_INTERVAL=60
# CITYBIKES_NETWORK_ID=pittsburgh